{
  "name": "iconin",
  "version": "1.0.0",
  "private": true,
  "description": "Insert and render Lucide icons in notes.",
  "type": "module",
  "scripts": {
    "generate:icons": "node scripts/generate-icon-names.mjs",
    "postinstall": "npm run generate:icons",
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "lucide": "1.41.0"
  },
  "devDependencies": {
    "@codemirror/language": "^6.11.3",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "^24.3.1",
    "builtin-modules": "^5.0.0",
    "esbuild": "^0.25.9",
    "obsidian": "1.13.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
